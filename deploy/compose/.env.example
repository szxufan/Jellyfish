## MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jellyfish
MYSQL_USER=jellyfish
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

## Redis / Celery Broker
# 必填：Redis 密码（compose 中 redis 服务强制 requirepass，未设置会启动失败）
# 生成方式：openssl rand -base64 24
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
# 如需单独覆盖完整 broker 地址，可设置：
# CELERY_BROKER_URL=redis://redis:6379/0

## Backend
# 可选：如需真实调用大模型，再设置
# OPENAI_API_KEY=

## RustFS (S3 compatible)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET_NAME=jellyfish-assets
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# 可选：RustFS 数据本地存储路径（绝对路径，适合独立数据盘场景，如 /data/jellyfish/rustfs）
# 未设置时使用 Docker 命名卷 rustfs_data；设置后改用 bind mount
# RUSTFS_DATA_PATH=

## Front runtime config (served as /env.js)
# 由于前后端分端口部署，浏览器应访问宿主机的后端地址
# 注意：front 容器现以 HTTPS 对外提供（宿主机端口 -> 容器 443），
# 若浏览器经 https 访问前端，需将 BACKEND_URL 改为 https 或与前端同源反代，避免 Mixed Content。
BACKEND_URL=http://localhost:8000

## Front HTTPS / Basic Auth
# 可选：自定义 TLS 证书（PEM 文本，含 BEGIN/END 行，单行变量）；二者必须同时提供，否则自动生成自签证书
# FRONT_TLS_CERT=
# FRONT_TLS_KEY=
# 自签证书的 Common Name / SAN（默认 localhost）
# FRONT_TLS_CN=localhost
# Basic Auth 账号密码（必填其一不设会导致 front 容器启动失败；生成强随机串可用 openssl rand -base64 24）
FRONT_BASIC_AUTH_USER=admin
FRONT_BASIC_AUTH_PASSWORD=
# 仅在确实不需要密码保护时显式设为 false（不推荐）
# FRONT_BASIC_AUTH=false
# 宿主机暴露端口（容器内固定监听 443）
# FRONT_PORT=7788
