## MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jellyfish
MYSQL_USER=jellyfish
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

## Redis / Celery Broker
# 必填：Redis 密码（compose 中 redis 服务强制 requirepass，未设置会启动失败）
# 生成方式：openssl rand -base64 24
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
# 如需单独覆盖完整 broker 地址，可设置：
# CELERY_BROKER_URL=redis://redis:6379/0

## Backend
# 可选：如需真实调用大模型，再设置
# OPENAI_API_KEY=

## RustFS (S3 compatible)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET_NAME=jellyfish-assets
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# 可选：RustFS 数据本地存储路径（绝对路径，适合独立数据盘场景，如 /data/jellyfish/rustfs）
# 未设置时使用 Docker 命名卷 rustfs_data；设置后改用 bind mount
# RUSTFS_DATA_PATH=

## Front runtime config (served as /env.js)
# 默认同源：浏览器请求经 front 容器 nginx 的 /api 反代转发到后端，无需设置 BACKEND_URL。
# 仅当你绕过 nginx 直连后端部署时才设置（须为浏览器可达的完整地址，如 https://api.mylinkpi.cn）。
# BACKEND_URL=

## Front HTTPS / Basic Auth
# 必填：TLS 证书与私钥（二者必须同时提供），填宿主机上文件的路径
# compose 会把这两个文件挂载进 front 容器（nginx 固定读取 /etc/nginx/certs/tls.crt|tls.key），
# entrypoint 启动时校验 PEM 合法性与证书/私钥配对，不合法会启动失败并给出明确报错。
FRONT_TLS_CERT=/path/to/mylinkpi.cn.pem
FRONT_TLS_KEY=/path/to/mylinkpi.cn.key
# Basic Auth 账号密码（必填其一不设会导致 front 容器启动失败；生成强随机串可用 openssl rand -base64 24）
FRONT_BASIC_AUTH_USER=admin
FRONT_BASIC_AUTH_PASSWORD=
# 仅在确实不需要密码保护时显式设为 false（不推荐）
# FRONT_BASIC_AUTH=false
# 宿主机暴露端口（容器内固定监听 443）
# FRONT_PORT=7788
